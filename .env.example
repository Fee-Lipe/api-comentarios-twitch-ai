# Credenciais da Twitch API
# Obtenha em: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=seu_client_id_aqui
TWITCH_CLIENT_SECRET=seu_client_secret_aqui

# Credenciais para IRC Chat (opcional - para chat anônimo não precisa)
# Para chat autenticado, obtenha em: https://twitchapps.com/tmi/
TWITCH_OAUTH_TOKEN=oauth:seu_token_aqui

# Gemini AI API Key
# Obtenha em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=sua_api_key_do_gemini_aqui

# Servidor
PORT=8080
